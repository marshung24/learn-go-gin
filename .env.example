# docker-compose 環境變數範本
# 使用方式：cp .env.example .env，再依需求修改

# 專案名稱（會用在容器名稱和 volume 名稱的前綴）
PROJECT_NAME=gin-app

# ── 應用程式設定 ──
APP_NAME=go-gin-app
APP_PORT=8080

# ── 資料庫連線（MySQL）──
# 本機開發用 localhost，容器內用 db（docker-compose service name）
DB_HOST=localhost
DB_PORT=3306
DB_USER=app
DB_PASSWORD=app
DB_NAME=app

# ── Redis 快取 ──
# 本機開發用 localhost，容器內用 redis（docker-compose service name）
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Docker Compose 映射 port ──
# 當本機已被佔用時可改成其他 port
MYSQL_PORT=3306
REDIS_PORT=6379
